    Rel(api, system, "Reads and writes platform state", "SQL")
    Rel(api, workspace, "Reads and writes workspace state", "SQL")
    Rel(api, files, "Reads and writes artifacts", "File I/O")
    Rel(cli, workspace, "Reads and writes workspace state", "SQL")
